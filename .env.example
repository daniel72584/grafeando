# Grafeando Web API environment variables
# Copy this file to .env for local development, or set these in Render's Environment settings.

# Public URL of your deployed Render API (leave empty for same-origin)
GRAFEANDO_API_URL=https://grafeando.onrender.com

# Comma-separated allowed CORS origins (or * for all)
GRAFEANDO_CORS_ORIGINS=*

# Optional: GitHub repo link shown in the UI
GRAFEANDO_GITHUB_REPO_URL=https://github.com/daniel72584/grafeando
